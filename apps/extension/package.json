{
  "name": "@apostrophi/extension",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Apostrophi browser extension: capture saves from Twitter/X, Instagram, Pinterest, Are.na, Cosmos, TikTok, YouTube and any article into the local Apostrophi library.",
  "license": "MIT",
  "author": {
    "name": "Apostrophi",
    "url": "https://github.com/apostrophi"
  },
  "homepage": "https://github.com/apostrophi/apostrophi#readme",
  "bugs": {
    "url": "https://github.com/apostrophi/apostrophi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apostrophi/apostrophi.git",
    "directory": "apps/extension"
  },
  "scripts": {
    "build": "wxt build",
    "dev": "wxt",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip"
  },
  "dependencies": {
    "@apostrophi/schema": "workspace:*",
    "@apostrophi/theme": "workspace:*",
    "@apostrophi/ui": "workspace:*",
    "@webext-core/messaging": "^4.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "^1.2.2",
    "sharp": "catalog:",
    "typescript": "catalog:",
    "wxt": "^0.21.4"
  }
}
