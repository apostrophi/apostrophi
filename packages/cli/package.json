{
  "name": "@apostrophi/cli",
  "version": "0.1.0",
  "description": "Command-line access to your local Apostrophi Library.",
  "type": "module",
  "bin": {
    "apostrophi": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "skill"
  ],
  "license": "MIT",
  "author": {
    "name": "Apostrophi",
    "url": "https://github.com/apostrophi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apostrophi/apostrophi.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "pack:check": "node scripts/smoke-pack.mjs",
    "smoke:pack": "pnpm build && node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apostrophi/local-api": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
